# Server Port (Google Cloud Run sets PORT automatically)
PORT=8080

# PostgreSQL Database Configuration
# Option A: Full connection string (Recommended for Neon / Supabase / local Postgres)
# Example local: postgres://postgres:your_password@localhost:5432/portfolio?sslmode=disable
# Example Neon:  postgres://user:pass@ep-cool-name.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Option B: Individual DB fields (used if DATABASE_URL is empty)
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSLMODE=

# Admin Authentication Credentials
# Never hardcode passwords in source code. Set these in .env locally or Cloud Run env vars.
ADMIN_USER=admin
# You can provide a bcrypt hash in ADMIN_PASSWORD_HASH (recommended for production)
# OR a plaintext password in ADMIN_PASSWORD (hashed in memory at startup using bcrypt).
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD=

# Secret key used to sign session cookies and CSRF tokens (32+ random characters recommended)
SESSION_SECRET=

